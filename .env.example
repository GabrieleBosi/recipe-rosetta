# Only needed to run the functions locally with `netlify dev`.
#
# In production this is set in the Netlify dashboard, under
# Site configuration -> Environment variables. It is read inside the function
# and never reaches the browser, so it must not be prefixed with VITE_ and must
# not be committed.

GEMINI_API_KEY=your-key-here

# Optional. Defaults to gemini-3.6-flash.
# GEMINI_MODEL=
